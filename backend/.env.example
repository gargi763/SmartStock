# Spring Boot does not automatically load .env files. Export these variables
# in the shell or configure them in your local run configuration.
SMARTSTOCK_DB_URL=jdbc:postgresql://localhost:5432/smartstock
SMARTSTOCK_DB_USERNAME=smartstock
SMARTSTOCK_DB_PASSWORD=replace-with-local-password
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Historical price and company-fundamentals requests need a provider key.
SMARTSTOCK_MARKET_DATA_API_KEY=
