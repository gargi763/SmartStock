# Copy these values into your local shell environment before starting the backend.
# Replace SMARTSTOCK_DB_PASSWORD with a password configured for your local PostgreSQL role.
SMARTSTOCK_DB_URL=jdbc:postgresql://localhost:5432/smartstock
SMARTSTOCK_DB_USERNAME=smartstock
SMARTSTOCK_DB_PASSWORD=replace-with-local-password
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SMARTSTOCK_MARKET_DATA_API_KEY=
